{
  "name": "iron-and-oak",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "bun run build && wrangler dev --config dist/server/wrangler.json",
    "astro": "astro",
    "lint": "oxlint",
    "format": "oxfmt",
    "prepare": "husky",
    "generate-types": "wrangler types",
    "deploy": "bun run build && wrangler deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.0.1",
    "astro": "7.0.3",
    "wrangler": "4.105.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
